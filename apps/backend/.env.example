# ── Entorno ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Orígenes permitidos por CORS (separados por coma). Apunta al frontend.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Base de datos (Supabase) ────────────────────────────────────────────────
# Pooled (runtime): pooler de Supabase en :6543 con ?pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
# Directa (migraciones): conexión directa en :5432
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Worker de campañas (claims atómicos en PostgreSQL) ─────────────────────
WORKER_CONCURRENCY=10
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_MS=30000

# ── Seguridad / JWT (usa secretos de >= 32 caracteres) ─────────────────────
JWT_SECRET=CHANGE_ME_min_32_characters_secret!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_min_32_characters_refresh!!
REFRESH_TOKEN_EXPIRES_IN=7d

# Clave de cifrado AES-256-GCM para tokens de Facebook (HEX de 64 caracteres)
TOKEN_ENCRYPTION_KEY=

# reCAPTCHA de Google (opcional para el login)
RECAPTCHA_SECRET_KEY=

# ── Meta / Facebook ────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v26.0
# Scopes OAuth separados por coma (pages_manage_metadata habilita subscribed_apps)
META_OAUTH_SCOPES=email,pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,pages_manage_metadata,business_management
# Debe apuntar a la ruta de callback del FRONTEND (Vercel/local).
META_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=

# ── IA (proveedor configurable) ────────────────────────────────────────────
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=