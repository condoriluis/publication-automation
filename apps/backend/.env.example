NODE_ENV=development
PORT=3001

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

WORKER_CONCURRENCY=10
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_MS=30000

JWT_SECRET=CHANGE_ME_min_32_characters_secret!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_min_32_characters_refresh!!
REFRESH_TOKEN_EXPIRES_IN=7d

TOKEN_ENCRYPTION_KEY=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v22.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=

AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=