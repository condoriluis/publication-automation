NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=
DIRECT_URL=

# Worker de campañas sin cola externa (claims atómicos en PostgreSQL)
WORKER_CONCURRENCY=10
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_MS=30000

# Seguridad / JWT
JWT_SECRET=change-me-min-32-caracteres-de-seguridad!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-tambien-min-32-caracteres!
REFRESH_TOKEN_EXPIRES_IN=7d

# Cifrado AES-256-GCM (clave HEX de 64 chars; vacío = clave de desarrollo)
TOKEN_ENCRYPTION_KEY=

# Meta / Facebook — poner credenciales reales de tu app de Meta
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v26.0
META_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# IA
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=