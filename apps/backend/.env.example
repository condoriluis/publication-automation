NODE_ENV=development
PORT=3001

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

WORKER_CONCURRENCY=10
WORKER_LEASE_MS=60000
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_MS=30000

# Sondeo de distribución de posts publicados (alerta cuando Meta restringe el alcance)
POST_INSIGHTS_WINDOW_HOURS=168
POST_INSIGHTS_REFRESH_AFTER_MS=3600000
POST_INSIGHTS_BATCH=20

COMMENT_POLL_INTERVAL_MIN=10
COMMENT_POLL_WINDOW_HOURS=24
COMMENT_POLL_MAX_POSTS=10
COMMENT_POLL_PAGE_DELAY_MS=250

JWT_SECRET=CHANGE_ME_min_32_characters_secret!!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_min_32_characters_refresh!!
REFRESH_TOKEN_EXPIRES_IN=7d

TOKEN_ENCRYPTION_KEY=

RECAPTCHA_SECRET_KEY=

AUDIT_RETENTION_DAYS=90

# ── Meta / Facebook ────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=v26.0

META_OAUTH_SCOPES=email,pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement,pages_manage_metadata,business_management
# Debe apuntar a la ruta de callback ve a: https://developers.facebook.com/apps/1726494234954420/business-login/settings.
META_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
META_WEBHOOK_VERIFY_TOKEN=

AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=