{
  "name": "publication-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Gestión y automatización de publicaciones e interacciones de páginas de Facebook mediante la API oficial de Meta",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace @pa/backend run start:dev",
    "dev:frontend": "npm --workspace @pa/frontend run dev",
    "build:backend": "npm --workspace @pa/backend run build",
    "build:frontend": "npm --workspace @pa/frontend run build",
    "db:migrate": "npm --workspace @pa/backend run prisma:migrate",
    "db:migrate:deploy": "npm --workspace @pa/backend run prisma:deploy",
    "db:generate": "npm --workspace @pa/backend run prisma:generate",
    "db:seed": "npm --workspace @pa/backend run prisma:seed",
    "db:studio": "npm --workspace @pa/backend run prisma:studio",
    "start:backend:prod": "npm --workspace @pa/backend run start:prod",
    "test": "npm --workspace @pa/backend run test",
    "lint": "npm --workspace @pa/frontend run lint && npm --workspace @pa/backend run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3"
  }
}
